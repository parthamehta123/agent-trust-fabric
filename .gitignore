# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# Secrets and key material — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
secrets/

# Reference material (screenshots/photos) must never enter history
*.jpeg
*.jpg
*.png
!docs/**/*.png

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf

# Build artifacts
sbom.json
.DS_Store

# Ephemeral local CA, service certs, client keys, generated configs (ADR-0015)
.local-ca/

# Auth0 credentials
.auth0-mcp-state.json

.auth0-mcp-writes.log

# OpenTofu (ADR-0026): never commit state, real variables, backend config or provider caches
infra/**/.terraform/
infra/modules/**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
infra/**/backend.hcl

# OpenTofu plan files can contain sensitive values (runbook writes them locally).
*.plan
*.tfplan
