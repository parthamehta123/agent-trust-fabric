# ADR-0028 Phase 1: the data plane's DPoP nonce key. The MCP, inference and A2A gateways share it,
# so any instance validates any instance's nonce with no shared state.
#
# The value never touches state or plan: it's generated by an *ephemeral* resource and written
# through a *write-only* argument. Rotate it by bumping var.dpop_nonce_key_version; while
# gateways roll, nonces from the old key fail once and agents retry with a fresh one.

locals {
  dpop_gateways = ["mcp-gateway", "inference-gateway", "a2a-gateway"]
}

ephemeral "aws_secretsmanager_random_password" "dpop_nonce" {
  password_length     = 64 # alphanumeric only: valid base64, 48 key bytes
  exclude_punctuation = true
  include_space       = false
}

resource "aws_secretsmanager_secret" "dpop_nonce" {
  # checkov:skip=CKV2_AWS_57:Rotated by bumping dpop_nonce_key_version (write-only re-generation), not a rotation Lambda.
  name                    = "${local.name}/data-plane/dpop-nonce-key"
  description             = "DPoP nonce HMAC key for the data-plane gateways (ADR-0028)."
  kms_key_id              = local.data_key
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "dpop_nonce" {
  secret_id                = aws_secretsmanager_secret.dpop_nonce.id
  secret_string_wo         = ephemeral.aws_secretsmanager_random_password.dpop_nonce.random_password
  secret_string_wo_version = var.dpop_nonce_key_version
}
